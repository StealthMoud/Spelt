{
  "name": "spelt",
  "version": "1.2.0",
  "description": "A calm vocabulary workspace for collecting words and building a daily spelling and recall habit.",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test && npm run build",
    "test:ui": "npm run build && node scripts/test-learning-ui.js",
    "icons": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6"
  }
}
