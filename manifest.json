{
  "manifest_version": 3,
  "name": "Spelt",
  "version": "1.0.0",
  "description": "Organized spelling and vocabulary trainer featuring Spaced Repetition (SRS) scheduling.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "contextMenus",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://tatoeba.org/*",
    "https://translate.googleapis.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://dictionary.cambridge.org/*",
    "https://www.oxfordlearnersdictionaries.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.datamuse.com/*",
    "https://ssl.gstatic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Spelt Popup"
    },
    "add-selection-to-spelt": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Add selected text to Spelt Vault"
    }
  }
}
